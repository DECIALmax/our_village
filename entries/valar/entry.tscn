[node name="Entry" type="Node2D" unique_id=1090446459]
y_sort_enabled = true
texture_filter = 1
metadata/layout_note = "按用户2026-09-29调整的横向L形空间重构：左厕所、中洗手台、右桌子与横向阁楼楼梯；入口在上侧；保留两扇下侧窗和隐藏凳子。"
metadata/material_note = "共享48像素图集；瓷砖使用room.tres；侧窗与木桌为场景内组合，原始素材不改写。"
metadata/refactor_note = "重建墙体边界、家具碰撞与导航；清除左墙外旧地板和上方悬空导航；中间凹位按用户手调范围替换为洗手台。"
metadata/wall_note = "已移除全部墙体边缘侧面；侧墙、隔墙及前墙只显示原素材墙顶轮廓，保持24像素占位。顶部完整墙面保留。"
metadata/aisle_note = "门与阁楼之间通道加宽48像素：右侧阁楼、楼梯、桌子及对应窗整体右移；床头靠右墙，原入口宽度不变。"

